{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "bun",
      "request": "attach",
      "name": "Attach to Bun",
      "url": "ws://localhost:6499/"
    },
    {
      "type": "bun",
      "request": "launch",
      "name": "Launch backend",
      "program": "${workspaceFolder}/backend/index.ts",
      "cwd": "${workspaceFolder}",
      "watch": true
    }
  ]
}
