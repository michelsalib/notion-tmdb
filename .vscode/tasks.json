{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "dev: frontend",
      "command": "bun start",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^$",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Frontend dev server on"
        }
      }
    }
  ]
}
