{
  "name": "notion-tmdb",
  "version": "1.0.0",
  "description": "An integration between Notion and TMDB",
  "type": "module",
  "scripts": {
    "check": "biome check",
    "format": "biome format --write .",
    "lint": "biome lint",
    "fix": "biome check --write .",
    "typecheck": "bun run typecheck:backend && bun run typecheck:frontend",
    "typecheck:backend": "bun x tsgo -p backend --noEmit",
    "typecheck:frontend": "bun x tsgo -p frontend --noEmit",
    "dev": "bun --env-file=backend/.env --watch --inspect backend/index.ts",
    "test": "bun test"
  },
  "author": "michelsalib@gmail.com",
  "license": "MIT",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2"
  },
  "private": true
}
