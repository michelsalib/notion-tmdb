# Engine selection
DB_ENGINE=MONGO
STORAGE_ENGINE=GCS
LOGGER_ENGINE=CONSOLE

# Server
PORT=7071

# Mongo (local dev → docker-compose mongo)
MONGO_URL=mongodb://localhost:27027

# GCS (local dev → docker-compose fake-gcs-server)
STORAGE_BUCKET=notion-backup
STORAGE_ENDPOINT=http://localhost:4443
GCP_PROJECT_ID=local-dev

# Notion OAuth — one per distro (5 distros use Notion auth)
NOTION_TMDB_CLIENT_ID=
NOTION_TMDB_CLIENT_SECRET=
NOTION_IGDB_CLIENT_ID=
NOTION_IGDB_CLIENT_SECRET=
NOTION_GBOOK_CLIENT_ID=
NOTION_GBOOK_CLIENT_SECRET=
NOTION_BACKUP_CLIENT_ID=
NOTION_BACKUP_CLIENT_SECRET=

# Third-party APIs
TMDB_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
